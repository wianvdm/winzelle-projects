{
  "name": "winzelle",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "node scripts/check-public-env.mjs && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.46",
    "lucide-react": "^0.545.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/router-plugin": "^1.169.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^31.0.0",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^7.3.8",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.1.0",
    "wrangler": "4.162.0"
  },
  "engines": {
    "node": ">=24.22.3 <25",
    "npm": ">=11"
  },
  "packageManager": "npm@11.19.1",
  "allowScripts": {
    "esbuild": true,
    "workerd": true
  }
}
