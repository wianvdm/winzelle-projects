# VITE_* values are public and baked into the browser bundle. Never put secrets in them.
# Web3Forms access key (https://web3forms.com); Workers Builds sets the real key.
VITE_WEB3FORMS_ACCESS_KEY=your-web3forms-access-key

# Builds fail in CI when this key is missing, blank, or still the placeholder above.

# Optional build flag for the /next redesign route.
# Defaults to on in `vite dev` and off in production builds; set to `true` to
# include /next in a production build (for example, CI design-gate runs).
# VITE_HOME_NEXT=true
