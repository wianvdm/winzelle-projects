{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "tabWidth": 2,
  "useTabs": false,
  "semi": false,
  "singleQuote": true,
  "trailingComma": "all",
  "endOfLine": "lf",
  "ignorePatterns": [
    "src/routeTree.gen.ts",
    "dist",
    "package-lock.json",
    "CHANGELOG.md"
  ]
}
